// everyday. for Windows. Warm paper, ink and clay, flat colours, serif headlines: the same design as the Mac app.
import { ScrollView, Palette, Switch } from "std-widgets.slint";
import "fonts/SourceSerif4.ttf";

export struct MailRow { thread-id: string, from: string, subject: string, summary: string, time: string, attention: bool, security: bool, count: int }
export struct Msg { from: string, time: string, body: string, attachments: string, breaks: int }
export struct Story { title: string, source: string, summary: string, url: string }
export struct TaskItem { id: string, title: string, due: string, overdue: bool }
export struct Section { heading: string, body: string, breaks: int }
export struct Turn { mine: bool, text: string, sources: string }
export struct EventRow { title: string, when: string }
export struct Topic { id: string, name: string, on: bool, index: int }
export struct TopicRow { items: [Topic] }
export struct SyncDevice { name: string, when: string }
export struct ReplyChip { label: string, handled: bool, index: int }

export global Ink {
    in-out property <bool> dark: Palette.color-scheme == ColorScheme.dark;
    out property <color> paper: dark ? #1c1a17 : #f5f0e4;
    out property <color> raised: dark ? #25231f : #fbf8f0;
    out property <color> sidebar: dark ? #201e1a : #efe8d9;
    out property <color> line: dark ? #38342d : #e3dacb;
    out property <color> text: dark ? #ece8df : #24201a;
    out property <color> text2: dark ? #a39e92 : #5b5346;
    out property <color> text3: dark ? #8c887d : #8a7f6c;
    out property <color> clay: dark ? #e08a6a : #d97856;
    out property <color> clay-soft: dark ? #3a2a22 : #f3dfd3;
    out property <color> alert: #b4442e;
    out property <string> serif: "Source Serif 4";
}

// Fades in and rises a few pixels when created. Used for pages, rows and cards.
component Appear inherits Rectangle {
    in property <duration> delay;
    in property <length> rise: 10px;
    property <float> t: 0;
    init => { self.t = 1; }
    animate t { duration: 320ms; delay: root.delay; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    opacity: t;
    min-height: inner.min-height; preferred-height: inner.preferred-height; max-height: inner.max-height;
    min-width: inner.min-width; preferred-width: inner.preferred-width;
    inner := VerticalLayout { y: (1 - root.t) * root.rise; width: parent.width; height: parent.height; @children }
}

// A whole page: fills its parent, same fade and rise.
component PageIn inherits Rectangle {
    property <float> t: 0;
    init => { self.t = 1; }
    animate t { duration: 260ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    opacity: t;
    Rectangle { y: (1 - root.t) * 12px; width: parent.width; height: parent.height; @children }
}

// Wrapped text that reserves enough height for its lines. Slint measures wrapped text at its unwrapped width,
// so the height is estimated from the character count, the width and any line breaks.
component Para inherits Text {
    in property <int> breaks;
    in property <float> glyph: 0.5;
    wrap: word-wrap;
    min-height: (ceil(self.text.character-count * self.font-size * self.glyph / max(1px, self.width - 8px)) + self.breaks) * self.font-size * 1.42;
}

component Label inherits Text { color: Ink.clay; font-size: 12.5px; font-weight: 600; }

// Springs in slightly when pressed; flat, no gradients.
component Button inherits Rectangle {
    in property <string> text;
    in property <bool> primary;
    in property <bool> enabled: true;
    in property <bool> danger;
    callback clicked;
    height: 38px;
    min-width: label.preferred-width + 34px;
    border-radius: primary ? 10px : 19px;
    background: !enabled ? Ink.line : primary ? (touch.has-hover ? Ink.text.mix(Ink.clay, 0.85) : Ink.text) : (touch.has-hover ? Ink.raised : transparent);
    border-width: primary ? 0 : 1px;
    border-color: Ink.line;
    opacity: touch.pressed ? 0.85 : 1;
    animate background { duration: 120ms; }
    label := Text { text: root.text; color: root.primary ? Ink.paper : root.danger ? Ink.alert : root.enabled ? Ink.text : Ink.text3; font-size: 14px; font-weight: root.primary ? 600 : 500; horizontal-alignment: center; vertical-alignment: center; }
    touch := TouchArea { mouse-cursor: root.enabled ? pointer : default; clicked => { if root.enabled { root.clicked(); } } }
}

component Chip inherits Rectangle {
    in property <string> text;
    in property <bool> on;
    callback clicked;
    height: 32px;
    min-width: t.preferred-width + 28px;
    border-radius: 16px;
    background: on ? Ink.clay-soft : touch.has-hover ? Ink.raised : transparent;
    border-width: 1px; border-color: on ? Ink.clay-soft : Ink.line;
    t := Text { text: root.text; color: root.on ? Ink.clay : Ink.text; font-size: 13.5px; font-weight: 500; vertical-alignment: center; horizontal-alignment: center; }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component Field inherits VerticalLayout {
    in property <string> label;
    in property <string> placeholder;
    in property <bool> secret;
    in property <bool> read-only;
    in property <bool> multi;
    in-out property <string> text <=> input.text;
    callback accepted();
    callback edited();
    spacing: 6px;
    if root.label != "": Text { text: root.label; color: Ink.text2; font-size: 13px; }
    Rectangle {
        min-height: root.multi ? 70px : 40px;
        max-height: root.multi ? 160px : 40px;
        border-radius: 10px; background: Ink.raised; border-width: 1px; border-color: input.has-focus ? Ink.clay : Ink.line;
        animate border-color { duration: 120ms; }
        if input.text == "": Text { x: 13px; y: root.multi ? 11px : (parent.height - self.height) / 2; text: root.placeholder; color: Ink.text3; font-size: 14.5px; }
        input := TextInput {
            x: 13px; y: root.multi ? 11px : (parent.height - self.height) / 2; width: parent.width - 26px; height: root.multi ? parent.height - 22px : self.preferred-height;
            color: Ink.text; font-size: 14.5px; selection-background-color: Ink.clay-soft; selection-foreground-color: Ink.text;
            input-type: root.secret ? InputType.password : InputType.text;
            read-only: root.read-only;
            single-line: !root.multi; wrap: root.multi ? word-wrap : no-wrap;
            accepted => { root.accepted(); }
            edited => { root.edited(); }
        }
    }
}

component Card inherits Rectangle {
    background: Ink.raised; border-radius: 16px; border-width: 1px; border-color: Ink.line;
}

component Hairline inherits Rectangle { height: 1px; background: Ink.line; }

component Wordmark inherits HorizontalLayout {
    in property <length> size: 22px;
    spacing: 0;
    alignment: start;
    Text { text: "everyday"; font-family: Ink.serif; font-size: root.size; color: Ink.text; }
    Text { text: "."; font-family: Ink.serif; font-size: root.size; color: Ink.clay; }
}

component NavItem inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> on;
    in property <bool> collapsed;
    in property <int> badge;
    callback clicked;
    height: 38px; border-radius: 8px;
    background: on ? Ink.paper : touch.has-hover ? Ink.paper.with-alpha(0.6) : transparent;
    animate background { duration: 100ms; }
    HorizontalLayout {
        padding-left: 12px; padding-right: 8px; spacing: 11px;
        Image { source: root.icon; width: 19px; height: 19px; y: (parent.height - 19px) / 2; colorize: root.on ? Ink.clay : Ink.text2; }
        if !root.collapsed: Text { text: root.text; vertical-alignment: center; color: root.on ? Ink.text : Ink.text2; font-size: 14.5px; font-weight: root.on ? 600 : 500; horizontal-stretch: 1; }
        if root.badge > 0 && !root.collapsed: Rectangle {
            width: max(20px, b.preferred-width + 12px); height: 20px; y: 9px; border-radius: 10px; background: Ink.clay;
            b := Text { text: root.badge; color: Ink.paper; font-size: 11.5px; font-weight: 600; }
        }
    }
    if root.badge > 0 && root.collapsed: Rectangle { x: 26px; y: 7px; width: 8px; height: 8px; border-radius: 4px; background: Ink.clay; }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component Empty inherits VerticalLayout {
    in property <string> title;
    in property <string> body;
    alignment: center; spacing: 6px; padding: 40px;
    Text { text: root.title; font-family: Ink.serif; font-size: 22px; color: Ink.text; horizontal-alignment: center; }
    Para { text: root.body; color: Ink.text2; font-size: 14.5px; horizontal-alignment: center;  }
}

component PageTitle inherits VerticalLayout {
    in property <string> title;
    in property <string> sub;
    spacing: 2px;
    Text { text: root.title; font-family: Ink.serif; font-size: 32px; color: Ink.text; }
    if root.sub != "": Para { text: root.sub; color: Ink.text2; font-size: 14px;  }
}

component MailRowView inherits Rectangle {
    in property <MailRow> mail;
    in property <bool> selected;
    callback clicked;
    height: lay.preferred-height;
    border-radius: 10px;
    background: selected ? Ink.raised : touch.has-hover ? Ink.raised.with-alpha(0.5) : transparent;
    lay := HorizontalLayout {
        padding: 12px; spacing: 10px;
        Rectangle { width: 7px; height: 7px; y: 18px; border-radius: 3.5px; background: root.mail.attention ? Ink.clay : transparent; }
        VerticalLayout {
            spacing: 2px;
            HorizontalLayout {
                spacing: 8px;
                Text { text: root.mail.from; color: Ink.text; font-size: 14.5px; font-weight: 600; overflow: elide; horizontal-stretch: 1; }
                if root.mail.count > 1: Text { text: root.mail.count; color: Ink.text3; font-size: 12px; }
                Text { text: root.mail.time; color: Ink.text3; font-size: 12px; }
            }
            Text { text: root.mail.subject; color: Ink.text; font-size: 13.5px; overflow: elide; }
            Text { text: root.mail.summary; color: Ink.text2; font-size: 13px; overflow: elide; }
        }
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component Check inherits Rectangle {
    in property <bool> done;
    callback clicked;
    width: 22px; height: 22px; border-radius: 11px;
    background: done ? Ink.clay : touch.has-hover ? Ink.clay-soft : transparent;
    border-width: 1.5px; border-color: done ? Ink.clay : Ink.text3;
    animate background { duration: 180ms; }
    if root.done: Text { text: "✓"; color: Ink.paper; font-size: 13px; font-weight: 700; }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component BriefingText inherits VerticalLayout {
    in property <[Section]> sections;
    spacing: 4px;
    for s[i] in root.sections: Appear { delay: i * 90ms; VerticalLayout {
        padding-top: i == 0 ? 0 : 10px; spacing: 4px;
        if s.heading != "": Text { text: s.heading; color: Ink.text2; font-size: 12.5px; font-weight: 600; }
        Para { text: s.body; breaks: s.breaks; glyph: 0.47; font-family: Ink.serif; font-size: 17px; color: Ink.text; }
    } }
}

// ---------- Pages ----------

component TodayPage inherits ScrollView {
    in property <string> greeting;
    in property <string> date-text;
    in property <[Section]> briefing;
    in property <bool> has-key;
    in property <bool> writing;
    in property <bool> speaking;
    in property <[ReplyChip]> replies;
    in property <[MailRow]> needs;
    in property <[EventRow]> events;
    in property <[TaskItem]> tasks;
    in property <[Story]> stories;
    callback write-briefing; callback listen; callback reply(int); callback open-thread(string); callback toggle-task(string); callback open-url(string); callback settings;
    VerticalLayout {
        padding: 40px; padding-top: 34px; spacing: 0;
        alignment: start;
        Text { text: root.date-text; color: Ink.clay; font-size: 13px; font-weight: 600; }
        Text { text: root.greeting; font-family: Ink.serif; font-size: 36px; color: Ink.text; }
        Rectangle { height: 22px; }
        HorizontalLayout {
            spacing: 28px; alignment: stretch;
            VerticalLayout {
                horizontal-stretch: 1; min-width: 320px; spacing: 12px; alignment: start;
                Card {
                    VerticalLayout {
                        padding: 22px; spacing: 12px;
                        HorizontalLayout {
                            Label { text: "Your briefing"; horizontal-stretch: 1; }
                            if root.briefing.length > 0 && root.has-key: Chip { text: root.speaking ? "Stop" : "Listen"; on: true; clicked => { root.listen(); } }
                        }
                        if root.writing: VerticalLayout {
                            spacing: 9px;
                            for w in [1.0, 0.92, 0.6]: HorizontalLayout { Rectangle { height: 13px; horizontal-stretch: w; border-radius: 6px; background: Ink.line; opacity: 0.55 + 0.35 * sin(animation-tick() / 1100ms * 360deg); } Rectangle { horizontal-stretch: 1.0 - w; } }
                            Text { text: "Writing…"; color: Ink.text3; font-size: 13px; }
                        }
                        if !root.writing && root.briefing.length > 0: BriefingText { sections: root.briefing; }
                        if !root.writing && root.briefing.length == 0 && !root.has-key: Para { text: "Add a Gemini key in Settings and everyday. will write you a short briefing each morning from your mail, calendar and the news."; color: Ink.text2; font-size: 15px;  }
                        if !root.writing && root.briefing.length == 0 && root.has-key: VerticalLayout {
                            spacing: 14px;
                            Para { text: "A few sentences on what needs you today, written from your mail, calendar and the news."; color: Ink.text2; font-size: 15px;  }
                            HorizontalLayout { alignment: start; Button { text: "Write my briefing"; primary: true; clicked => { root.write-briefing(); } } }
                        }
                        if !root.writing && root.briefing.length > 0: HorizontalLayout {
                            alignment: start;
                            Text { text: "Write it again"; color: Ink.text3; font-size: 13px; TouchArea { mouse-cursor: pointer; clicked => { root.write-briefing(); } } }
                        }
                    }
                }
                if root.replies.length > 0: HorizontalLayout {
                    spacing: 8px; alignment: start;
                    for r in root.replies: Chip { text: r.label; on: r.handled; clicked => { root.reply(r.index); } }
                }
                if root.needs.length > 0: VerticalLayout {
                    padding-top: 18px; spacing: 2px;
                    Label { text: "Needs you"; }
                    for r[i] in root.needs: Appear { delay: min(i, 8) * 40ms; MailRowView { mail: r; clicked => { root.open-thread(r.thread-id); } } }
                }
            }
            VerticalLayout {
                width: 250px; spacing: 8px; alignment: start;
                Label { text: "Up next"; }
                if root.events.length == 0: Para { text: "Add a calendar link in Settings to see your day here."; color: Ink.text3; font-size: 13.5px;  }
                for e in root.events: HorizontalLayout {
                    spacing: 12px; padding-top: 4px; padding-bottom: 4px;
                    Rectangle { width: 3px; border-radius: 2px; background: Ink.clay; }
                    VerticalLayout { Para { text: e.title; color: Ink.text; font-size: 14.5px; font-weight: 500;  } Text { text: e.when; color: Ink.text2; font-size: 12.5px; } }
                }
                Rectangle { height: 18px; }
                Label { text: "Tasks"; }
                if root.tasks.length == 0: Text { text: "Nothing to do."; color: Ink.text3; font-size: 13.5px; }
                for t in root.tasks: HorizontalLayout {
                    spacing: 12px; padding-top: 5px; padding-bottom: 5px;
                    Check { y: 1px; clicked => { root.toggle-task(t.id); } }
                    VerticalLayout { Para { text: t.title; color: Ink.text; font-size: 14.5px;  } if t.due != "": Text { text: t.due; color: t.overdue ? Ink.clay : Ink.text3; font-size: 12px; } }
                }
                Rectangle { height: 18px; }
                if root.stories.length > 0: Label { text: "Top story"; }
                if root.stories.length > 0: VerticalLayout {
                    spacing: 4px;
                    Text { text: root.stories[0].title; font-family: Ink.serif; font-size: 18px; color: Ink.text; wrap: word-wrap; TouchArea { mouse-cursor: pointer; clicked => { root.open-url(root.stories[0].url); } } }
                    Text { text: root.stories[0].source; color: Ink.text3; font-size: 12.5px; }
                }
            }
        }
    }
}

component ThreadPane inherits Rectangle {
    in property <string> subject;
    in property <string> summary;
    in property <bool> security;
    in property <[Msg]> messages;
    in property <int> countdown;
    in-out property <string> draft;
    callback archive; callback trash; callback snooze(int); callback handled; callback send; callback undo;
    VerticalLayout {
        HorizontalLayout {
            padding: 14px; padding-left: 28px; spacing: 8px; alignment: end;
            Button { text: "Archive"; clicked => { root.archive(); } }
            Button { text: "Later today"; clicked => { root.snooze(4); } }
            Button { text: "Tomorrow"; clicked => { root.snooze(18); } }
            if !root.security: Button { text: "That was me"; clicked => { root.handled(); } }
            Button { text: "Trash"; danger: true; clicked => { root.trash(); } }
        }
        Hairline {}
        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                padding: 28px; spacing: 14px; alignment: start;
                Para { text: root.subject; font-family: Ink.serif; font-size: 25px; color: Ink.text;  }
                if root.summary != "": Rectangle {
                    background: Ink.raised; border-radius: 10px;
                    VerticalLayout { padding: 12px; Para { text: root.summary; color: Ink.text2; font-size: 13.5px;  } }
                }
                // Account-security notices get "That was me" up front; ordinary mail has it in the toolbar.
                if root.security: Card {
                    VerticalLayout {
                        padding: 16px; spacing: 8px;
                        Text { text: "Was this you?"; color: Ink.text; font-size: 15px; font-weight: 600; }
                        Para { text: "If you just signed in or changed a setting, mark it handled. If not, check your account now."; color: Ink.text2; font-size: 13.5px;  }
                        HorizontalLayout { alignment: start; Button { text: "That was me"; primary: true; clicked => { root.handled(); } } }
                    }
                }
                for m in root.messages: VerticalLayout {
                    spacing: 8px; padding-top: 8px;
                    HorizontalLayout { Text { text: m.from; color: Ink.text; font-size: 14.5px; font-weight: 600; horizontal-stretch: 1; } Text { text: m.time; color: Ink.text3; font-size: 12.5px; } }
                    Para { text: m.body; breaks: m.breaks; glyph: 0.47; font-family: Ink.serif; font-size: 16px; color: Ink.text; }
                    if m.attachments != "": Text { text: "Attached: " + m.attachments; color: Ink.text3; font-size: 12.5px; }
                    Hairline {}
                }
            }
        }
        if root.countdown > 0: Rectangle {
            height: 52px; background: Ink.text;
            HorizontalLayout {
                padding-left: 28px; padding-right: 28px;
                Text { text: "Sending in " + root.countdown + "…"; color: Ink.paper; font-size: 14px; vertical-alignment: center; horizontal-stretch: 1; }
                Text { text: "Undo"; color: Ink.clay; font-size: 14px; font-weight: 600; vertical-alignment: center; TouchArea { mouse-cursor: pointer; clicked => { root.undo(); } } }
            }
        }
        if root.countdown == 0: HorizontalLayout {
            padding: 16px; padding-left: 28px; padding-right: 28px; spacing: 10px;
            Field { multi: true; placeholder: "Write a reply"; text <=> root.draft; horizontal-stretch: 1; }
            VerticalLayout { alignment: end; Button { text: "Send"; primary: true; enabled: root.draft != ""; clicked => { root.send(); } } }
        }
    }
}

component InboxPage inherits HorizontalLayout {
    in property <[MailRow]> needs;
    in property <[MailRow]> rest;
    in property <bool> connected;
    in property <bool> syncing;
    in property <string> selected;
    in property <string> subject; in property <string> summary; in property <bool> security; in property <[Msg]> messages; in property <int> countdown;
    in-out property <string> draft;
    callback open-thread(string); callback refresh; callback archive; callback trash; callback snooze(int); callback handled; callback send; callback undo;
    Rectangle {
        width: 380px; background: Ink.paper;
        VerticalLayout {
            HorizontalLayout {
                padding: 24px; padding-bottom: 10px;
                PageTitle { title: "Inbox"; sub: !root.connected ? "No mail connected" : root.needs.length == 0 ? "Nothing needs you" : root.needs.length + (root.needs.length == 1 ? " needs you" : " need you"); horizontal-stretch: 1; }
                VerticalLayout { alignment: start; Button { text: root.syncing ? "Checking…" : "Check mail"; enabled: !root.syncing && root.connected; clicked => { root.refresh(); } } }
            }
            ScrollView {
                VerticalLayout {
                    padding: 10px; spacing: 1px; alignment: start;
                    if !root.connected: Empty { title: "Connect your mail"; body: "Open Settings and add an account with an app password."; }
                    if root.needs.length > 0: Label { text: "Needs you"; x: 12px; }
                    for r in root.needs: MailRowView { mail: r; selected: r.thread-id == root.selected; clicked => { root.open-thread(r.thread-id); } }
                    if root.rest.length > 0: Rectangle { height: 14px; }
                    if root.rest.length > 0: Label { text: "Everything else"; }
                    for r in root.rest: MailRowView { mail: r; selected: r.thread-id == root.selected; clicked => { root.open-thread(r.thread-id); } }
                }
            }
        }
    }
    Rectangle { width: 1px; background: Ink.line; }
    if root.selected == "": Empty { title: root.connected ? "Pick a conversation" : ""; body: root.connected ? "Archive, snooze and reply from here. Replies wait ten seconds so you can undo." : ""; horizontal-stretch: 1; }
    if root.selected != "": ThreadPane {
        horizontal-stretch: 1;
        subject: root.subject; summary: root.summary; security: root.security; messages: root.messages; countdown: root.countdown; draft <=> root.draft;
        archive => { root.archive(); } trash => { root.trash(); } snooze(h) => { root.snooze(h); } handled => { root.handled(); } send => { root.send(); } undo => { root.undo(); }
    }
}

component TopicPicker inherits VerticalLayout {
    in property <[TopicRow]> topics;
    callback toggle(int);
    spacing: 8px;
    // Rows come pre-split from Rust; Slint has no flowing wrap layout.
    for r in root.topics: HorizontalLayout {
        spacing: 8px; alignment: start;
        for t in r.items: Appear { delay: t.index * 18ms; rise: 6px; Chip { text: t.name; on: t.on; clicked => { root.toggle(t.index); } } }
    }
}

// The swipe deck: Less, More or Love. Cards fly off left, right or up; drag them, or use keys ← → ↑.
component Deck inherits VerticalLayout {
    in property <[Story]> deck;
    in property <string> done-text: "Your choices tune Top stories.";
    callback react(int);
    alignment: center; spacing: 12px;
    if root.deck.length == 0: Empty { title: "You're through the deck"; body: root.done-text; }
    if root.deck.length > 0: HorizontalLayout {
        alignment: center;
        Rectangle {
            width: 540px; height: 360px;
            // Next card waits underneath, slightly smaller.
            if root.deck.length > 1: Card { width: parent.width; height: parent.height; transform-scale: 0.95 + 0.05 * min(1, abs(card.fling) + abs(card.lift) + abs(card.drag) / 300px); opacity: 0.6; }
            card := Card {
                property <float> fling;
                property <float> lift;
                property <length> drag;
                property <int> pending;
                width: parent.width; height: parent.height;
                x: fling * 620px + drag;
                y: -lift * 520px;
                transform-rotation: fling * 18deg + drag / 30px * 1deg;
                opacity: 1 - max(abs(fling), abs(lift)) * 0.9;
                animate fling, lift { duration: 260ms; easing: cubic-bezier(0.4, 0, 0.9, 0.6); }
                animate drag { duration: 180ms; easing: ease-out; }
                Timer { interval: 270ms; running: card.fling != 0 || card.lift != 0; triggered => { root.react(card.pending); card.fling = 0; card.lift = 0; card.drag = 0; } }
                // Drag the card itself: past 140px it flies off that way.
                swipe := TouchArea {
                    moved => { if self.pressed { card.drag = self.mouse-x - self.pressed-x; } }
                    pointer-event(e) => {
                        if e.kind == PointerEventKind.up {
                            if card.drag > 140px { card.pending = 1; card.fling = 1; }
                            else if card.drag < -140px { card.pending = -1; card.fling = -1; }
                            else { card.drag = 0; }
                        }
                    }
                }
                VerticalLayout {
                    padding: 30px; spacing: 12px;
                    HorizontalLayout {
                        Label { text: root.deck[0].source; horizontal-stretch: 1; }
                        Text { text: card.drag > 40px ? "More" : card.drag < -40px ? "Less" : ""; color: Ink.clay; font-size: 13px; font-weight: 600; opacity: min(1, abs(card.drag) / 140px); }
                    }
                    Para { text: root.deck[0].title; glyph: 0.47; font-family: Ink.serif; font-size: 26px; color: Ink.text; }
                    Text { text: root.deck[0].summary; color: Ink.text2; font-size: 14.5px; wrap: word-wrap; vertical-stretch: 1; overflow: elide; }
                    HorizontalLayout {
                        spacing: 10px; alignment: center;
                        Button { text: "Less like this"; clicked => { card.pending = -1; card.fling = -1; } }
                        Button { text: "More like this"; clicked => { card.pending = 1; card.fling = 1; } }
                        Button { text: "Love it"; primary: true; clicked => { card.pending = 2; card.lift = 1; } }
                    }
                }
            }
        }
    }
    if root.deck.length > 0: Text { text: root.deck.length + " left. Drag the card, or keys: ← less, → more, ↑ love"; color: Ink.text3; font-size: 12.5px; horizontal-alignment: center; }
}

component NewsPage inherits VerticalLayout {
    in property <[Story]> stories;
    in property <[Story]> deck;
    in-out property <int> mode;
    callback open-url(string); callback react(int); callback refresh;
    padding: 40px; padding-top: 34px; spacing: 14px;
    HorizontalLayout {
        PageTitle { title: "News"; horizontal-stretch: 1; }
        HorizontalLayout { spacing: 8px; alignment: end; Chip { text: "Top stories"; on: root.mode == 0; clicked => { root.mode = 0; } } Chip { text: "Teach me"; on: root.mode == 1; clicked => { root.mode = 1; } } }
    }
    if root.mode == 0: ScrollView {
        VerticalLayout {
            alignment: start; spacing: 0;
            if root.stories.length == 0: Empty { title: "No stories yet"; body: "They arrive with the next refresh."; }
            for s[i] in root.stories: Appear { delay: min(i, 10) * 35ms; Rectangle {
                height: sl.preferred-height;
                background: st.has-hover ? Ink.raised.with-alpha(0.6) : transparent; border-radius: 10px;
                sl := VerticalLayout {
                    padding: 14px; spacing: 4px;
                    Para { text: s.title; font-family: Ink.serif; font-size: 19px; color: Ink.text;  }
                    if s.summary != "": Para { text: s.summary; color: Ink.text2; font-size: 13.5px;  max-height: 38px; overflow: elide; }
                    Text { text: s.source; color: Ink.text3; font-size: 12.5px; }
                }
                st := TouchArea { mouse-cursor: pointer; clicked => { root.open-url(s.url); } }
            } }
        }
    }
    // Teach me: one card at a time. Less, More or Love tune Top stories.
    if root.mode == 1: Deck { deck: root.deck; react(r) => { root.react(r); } vertical-stretch: 1; }
}

component TasksPage inherits VerticalLayout {
    in property <[TaskItem]> tasks;
    in-out property <string> input;
    callback add; callback toggle(string); callback delete(string);
    padding: 40px; padding-top: 34px; spacing: 16px;
    PageTitle { title: "Tasks"; sub: "Type naturally: “Call Oscar Friday 3pm”, “Pay rent every month”."; }
    HorizontalLayout { spacing: 10px; Field { placeholder: "Add a task"; text <=> root.input; accepted => { root.add(); } horizontal-stretch: 1; } VerticalLayout { alignment: end; Button { text: "Add"; enabled: root.input != ""; clicked => { root.add(); } } } }
    ScrollView {
        VerticalLayout {
            alignment: start;
            if root.tasks.length == 0: Empty { title: "Nothing to do"; body: "Add something above, or let the briefing suggest tasks from your mail."; }
            for t in root.tasks: Rectangle {
                height: tl.preferred-height;
                background: th.has-hover ? Ink.raised.with-alpha(0.6) : transparent; border-radius: 8px;
                th := TouchArea {}
                tl := HorizontalLayout {
                    padding: 10px; spacing: 14px;
                    Check { y: 11px; clicked => { root.toggle(t.id); } }
                    VerticalLayout { horizontal-stretch: 1; Para { text: t.title; color: Ink.text; font-size: 15px;  } if t.due != "": Text { text: t.due; color: t.overdue ? Ink.clay : Ink.text3; font-size: 12.5px; } }
                    if th.has-hover: Text { text: "Delete"; color: Ink.alert; font-size: 13px; vertical-alignment: center; TouchArea { mouse-cursor: pointer; clicked => { root.delete(t.id); } } }
                }
            }
        }
    }
}

component AskPage inherits VerticalLayout {
    in property <[Turn]> turns;
    in property <bool> thinking;
    in property <bool> has-key;
    in-out property <string> input;
    callback ask(string);
    padding: 40px; padding-top: 34px; spacing: 14px;
    PageTitle { title: "Ask"; sub: "About your mail, calendar, tasks and the news. It reads; it never sends or deletes."; }
    ScrollView {
        vertical-stretch: 1;
        VerticalLayout {
            alignment: start; spacing: 12px; padding-top: 8px;
            if root.turns.length == 0: HorizontalLayout {
                spacing: 8px; alignment: start;
                for q in ["What needs me today?", "Anything due this week?", "Summarise the news"]: Chip { text: q; clicked => { root.ask(q); } }
            }
            for t in root.turns: Appear { HorizontalLayout {
                alignment: t.mine ? end : start;
                Rectangle {
                    max-width: 620px;
                    background: t.mine ? Ink.text : Ink.raised; border-radius: 16px;
                    VerticalLayout {
                        padding: 14px; padding-top: 10px; padding-bottom: 10px; spacing: 6px;
                        Para { text: t.text; color: t.mine ? Ink.paper : Ink.text; font-size: 15px; font-family: t.mine ? "" : Ink.serif;  }
                        if t.sources != "": Para { text: "From: " + t.sources; color: Ink.text3; font-size: 12px;  }
                    }
                }
            } }
            if root.thinking: Text { text: "Thinking…"; color: Ink.text3; font-size: 13.5px; }
        }
    }
    HorizontalLayout {
        spacing: 10px;
        Field { placeholder: root.has-key ? "Ask anything" : "Add a Gemini key in Settings first"; text <=> root.input; accepted => { if root.input != "" { root.ask(root.input); } } horizontal-stretch: 1; }
        VerticalLayout { alignment: end; Button { text: "Ask"; primary: true; enabled: root.input != "" && !root.thinking; clicked => { root.ask(root.input); } } }
    }
}

component MailSetup inherits VerticalLayout {
    in-out property <int> provider;
    in-out property <string> email;
    in-out property <string> password;
    in property <bool> busy;
    in property <string> error;
    callback connect;
    out property <[string]> names: ["Gmail", "iCloud", "Outlook", "Fastmail"];
    out property <[string]> help: ["Make an app password at myaccount.google.com/apppasswords (needs 2-Step Verification).", "Make an app-specific password at account.apple.com, under Sign-In and Security.", "Make an app password in your Microsoft account's security settings.", "Make an app password in Fastmail under Settings, Privacy & Security."];
    spacing: 12px;
    HorizontalLayout { spacing: 8px; alignment: start; for n[i] in root.names: Chip { text: n; on: root.provider == i; clicked => { root.provider = i; } } }
    Field { label: "Email address"; placeholder: "you@example.com"; text <=> root.email; }
    Field { label: "App password"; placeholder: "xxxx xxxx xxxx xxxx"; secret: true; text <=> root.password; accepted => { root.connect(); } }
    Para { text: root.help[root.provider]; color: Ink.text2; font-size: 13px;  }
    if root.error != "": Para { text: root.error; color: Ink.alert; font-size: 13px;  }
    HorizontalLayout { alignment: start; Button { text: root.busy ? "Connecting…" : "Connect " + root.names[root.provider]; primary: true; enabled: !root.busy; clicked => { root.connect(); } } }
}

component SettingsTab inherits Rectangle {
    in property <string> text;
    in property <bool> on;
    callback clicked;
    height: 32px; border-radius: 7px;
    background: on ? Ink.clay-soft : ta.has-hover ? Ink.raised : transparent;
    animate background { duration: 100ms; }
    Text { x: 12px; text: root.text; color: root.on ? Ink.clay : Ink.text; font-size: 14px; font-weight: root.on ? 600 : 400; vertical-alignment: center; height: parent.height; }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// Pairing stays on this computer; codes are shown only when explicitly requested.
component SyncPane inherits VerticalLayout {
    in property <bool> paired;
    in property <int> nearby;
    in property <[SyncDevice]> devices;
    in property <string> error;
    in property <bool> busy;
    in property <string> code;
    in property <image> qr;
    in-out property <bool> include-setup: true;
    in-out property <string> entered;
    callback show-code; callback hide-code; callback join; callback sync-now; callback leave;
    spacing: 12px;
    Para { text: "Keep tasks, news topics and handled mail the same on your Mac, Android phone and Windows PC. Devices talk directly over your Wi‑Fi, encrypted with a key only they hold. Nothing goes through a server."; color: Ink.text2; font-size: 15px; }
    Rectangle { height: 6px; }
    Label { text: "This PC"; }
    if !root.paired: Text { text: "Not paired yet."; color: Ink.text2; font-size: 15px; }
    if root.paired: HorizontalLayout {
        spacing: 12px;
        Para { text: root.nearby == 0 ? "Paired. Looking for your other devices on this network." : root.nearby + (root.nearby == 1 ? " device nearby." : " devices nearby."); color: Ink.text2; font-size: 15px; horizontal-stretch: 1; }
        Button { text: root.busy ? "Syncing…" : "Sync now"; enabled: !root.busy; clicked => { root.sync-now(); } }
    }
    for d in root.devices: HorizontalLayout {
        spacing: 12px;
        Text { text: d.name; color: Ink.text; font-size: 15px; horizontal-stretch: 1; overflow: elide; }
        Text { text: d.when; color: Ink.text3; font-size: 13px; }
    }
    if root.error != "": Para { text: root.error; color: Ink.alert; font-size: 13px; }
    Rectangle { height: 6px; }
    Label { text: "Add a device"; }
    Para { text: "On the other device, open Settings → Sync and scan this code, or type it in."; color: Ink.text2; font-size: 14px; }
    if root.code == "": VerticalLayout {
        spacing: 12px;
        HorizontalLayout {
            spacing: 12px;
            VerticalLayout {
                spacing: 4px; horizontal-stretch: 1;
                Text { text: "Include my accounts and keys"; color: Ink.text; font-size: 15px; }
                Para { text: "Quick setup: the new device gets your mail accounts and passwords, AI keys and settings, so there's nothing to type. The code works once, for 10 minutes."; color: Ink.text2; font-size: 13px; }
            }
            Switch { checked <=> root.include-setup; }
        }
        HorizontalLayout { alignment: start; Button { text: "Show pairing code"; primary: true; enabled: !root.busy; clicked => { root.show-code(); } } }
    }
    if root.code != "": Appear { VerticalLayout {
        spacing: 10px;
        HorizontalLayout { alignment: start; Rectangle {
            width: 200px; height: 200px; background: white; border-radius: 12px;
            Image { x: 10px; y: 10px; width: 180px; height: 180px; source: root.qr; image-fit: contain; }
        } }
        // An editable field supports the usual select/copy keyboard shortcuts.
        Field { label: "Pairing code"; text: root.code; read-only: true; }
        Para { text: root.include-setup ? "This code carries your mail passwords and AI keys for the next 10 minutes. Only show it to your own devices." : "Anyone with this code can join your devices. Only show it to your own."; color: Ink.text3; font-size: 12.5px; }
        HorizontalLayout { alignment: start; Button { text: "Hide code"; clicked => { root.hide-code(); } } }
    } }
    Rectangle { height: 6px; }
    Label { text: "Join another device"; }
    HorizontalLayout {
        spacing: 10px;
        Field { placeholder: "Paste the code from your other device"; text <=> root.entered; horizontal-stretch: 1; accepted => { if root.entered != "" && !root.busy { root.join(); } } }
        Button { text: "Join"; enabled: root.entered != "" && !root.busy; clicked => { root.join(); } }
    }
    if root.paired: HorizontalLayout { alignment: start; Button { text: "Stop syncing on this PC"; danger: true; enabled: !root.busy; clicked => { root.leave(); } } }
}

// Settings in tabs, like the Mac app: one topic per pane.
component SettingsPage inherits HorizontalLayout {
    in-out property <int> tab;
    in-out property <string> name;
    in property <string> email;
    in property <bool> has-key;
    in-out property <string> key-input;
    in-out property <string> ics;
    in-out property <bool> morning;
    in-out property <int> hour;
    in-out property <string> instructions;
    in property <[TopicRow]> topics;
    in property <string> top-interests;
    in-out property <int> provider; in-out property <string> mail-email; in-out property <string> mail-password; in property <bool> busy; in property <string> error; in property <string> key-note;
    in property <bool> sync-paired; in property <int> sync-nearby; in property <[SyncDevice]> sync-devices;
    in property <string> sync-error; in property <bool> sync-busy; in property <string> sync-code; in property <image> sync-qr;
    in-out property <bool> sync-include-setup: true; in-out property <string> sync-entered;
    callback sync-show-code; callback sync-hide-code; callback sync-join; callback sync-now; callback sync-leave;
    callback save-name; callback save-ics; callback save-morning; callback connect; callback disconnect; callback save-key; callback save-instructions;
    callback toggle-topic(int); callback train; callback reset-interests;
    Rectangle {
        width: 200px;
        VerticalLayout {
            padding: 24px; padding-top: 34px; padding-right: 10px; spacing: 2px; alignment: start;
            Text { text: "Settings"; font-family: Ink.serif; font-size: 26px; color: Ink.text; }
            Rectangle { height: 14px; }
            for t[i] in ["General", "Accounts", "AI provider", "Briefing", "Interests", "Calendar", "Sync", "About"]: SettingsTab { text: t; on: root.tab == i; clicked => { root.tab = i; } }
        }
    }
    Rectangle { width: 1px; background: Ink.line; }
    ScrollView {
        horizontal-stretch: 1;
        VerticalLayout {
            padding: 40px; padding-top: 40px; spacing: 12px; alignment: start;
            if root.tab == 0: Appear { VerticalLayout {
                spacing: 12px;
                Label { text: "You"; }
                HorizontalLayout { Field { label: "First name"; placeholder: "For the greeting and briefing"; text <=> root.name; edited => { root.save-name(); } max-width: 420px; } }
                Rectangle { height: 10px; }
                Label { text: "Morning briefing"; }
                HorizontalLayout { spacing: 14px; alignment: start; Switch { checked <=> root.morning; toggled => { root.save-morning(); } } Text { text: "Write it each morning"; color: Ink.text; font-size: 14.5px; vertical-alignment: center; } }
                if root.morning: HorizontalLayout { spacing: 8px; alignment: start; for h in [5, 6, 7, 8, 9, 10]: Chip { text: h + ":00"; on: root.hour == h; clicked => { root.hour = h; root.save-morning(); } } }
            } }
            if root.tab == 1: Appear { VerticalLayout {
                spacing: 12px;
                Label { text: "Mail"; }
                if root.email != "": HorizontalLayout { spacing: 14px; alignment: start; Text { text: root.email; color: Ink.text; font-size: 15px; vertical-alignment: center; } Button { text: "Disconnect"; clicked => { root.disconnect(); } } }
                if root.email == "": Para { text: "Connect any mail account with an app password. It takes about a minute and nothing passes through a server of ours."; color: Ink.text2; font-size: 14.5px; }
                if root.email == "": HorizontalLayout { MailSetup { provider <=> root.provider; email <=> root.mail-email; password <=> root.mail-password; busy: root.busy; error: root.error; connect => { root.connect(); } max-width: 520px; } }
            } }
            if root.tab == 2: Appear { VerticalLayout {
                spacing: 12px;
                Label { text: "Gemini"; }
                if root.has-key: Text { text: "Key saved in Windows Credential Manager."; color: Ink.text; font-size: 15px; }
                HorizontalLayout { spacing: 10px; Field { label: root.has-key ? "Replace the key" : "API key"; placeholder: "AIza…"; secret: true; text <=> root.key-input; max-width: 420px; } VerticalLayout { alignment: end; Button { text: "Save key"; enabled: root.key-input != ""; clicked => { root.save-key(); } } } }
                Para { text: root.key-note != "" ? root.key-note : "Free from aistudio.google.com. It sorts your mail, writes the briefing and reads it aloud. The AI only ever returns text: it can't send, archive or delete anything."; color: Ink.text2; font-size: 13.5px; }
            } }
            if root.tab == 3: Appear { VerticalLayout {
                spacing: 12px;
                Label { text: "Standing instructions"; }
                Para { text: "Added to every briefing. For example: “Keep it under 80 words”, “Always mention the weather first”."; color: Ink.text2; font-size: 13.5px; }
                HorizontalLayout { Field { multi: true; placeholder: "Write how you like your briefing"; text <=> root.instructions; edited => { root.save-instructions(); } max-width: 560px; } }
            } }
            if root.tab == 4: Appear { VerticalLayout {
                spacing: 12px;
                Label { text: "Topics you follow"; }
                Para { text: "Tap to add or remove. Top stories lean towards these."; color: Ink.text2; font-size: 13.5px; }
                TopicPicker { topics: root.topics; toggle(i) => { root.toggle-topic(i); } }
                Rectangle { height: 10px; }
                Label { text: "What it has learned"; }
                Para { text: root.top-interests != "" ? root.top-interests : "Nothing yet. Swipe a few stories to teach it."; color: Ink.text; font-size: 14.5px; }
                HorizontalLayout { spacing: 10px; alignment: start; Button { text: "Train with more stories"; primary: true; clicked => { root.train(); } } Button { text: "Start over"; danger: true; clicked => { root.reset-interests(); } } }
            } }
            if root.tab == 5: Appear { VerticalLayout {
                spacing: 12px;
                Label { text: "Calendar"; }
                HorizontalLayout { Field { label: "Calendar link (.ics)"; placeholder: "https://… from Google, Outlook or iCloud"; text <=> root.ics; edited => { root.save-ics(); } max-width: 560px; } }
                Para { text: "In Google Calendar: Settings, your calendar, “Secret address in iCal format”. Outlook and iCloud can publish one too. everyday. only reads it."; color: Ink.text2; font-size: 13.5px; }
            } }
            if root.tab == 6: Appear { SyncPane {
                paired: root.sync-paired; nearby: root.sync-nearby; devices: root.sync-devices; error: root.sync-error; busy: root.sync-busy;
                code: root.sync-code; qr: root.sync-qr; include-setup <=> root.sync-include-setup; entered <=> root.sync-entered;
                show-code => { root.sync-show-code(); } hide-code => { root.sync-hide-code(); } join => { root.sync-join(); } sync-now => { root.sync-now(); } leave => { root.sync-leave(); }
            } }
            if root.tab == 7: Appear { VerticalLayout {
                spacing: 10px;
                Wordmark { size: 34px; }
                Text { text: "Version 0.2"; color: Ink.text2; font-size: 14px; }
                Para { text: "Free and open source under GPL-3.0. Your mail stays on this computer and talks only to your mail server, your news sources and the AI you choose."; color: Ink.text2; font-size: 14px; max-width: 520px; }
            } }
        }
    }
}

component Onboarding inherits Rectangle {
    in-out property <int> step;
    in-out property <string> name;
    in property <[TopicRow]> topics;
    in property <[Story]> deck;
    in-out property <int> provider; in-out property <string> mail-email; in-out property <string> mail-password; in property <bool> busy; in property <string> error;
    in-out property <string> key-input; in property <string> key-note;
    callback connect; callback save-key; callback finish; callback save-name; callback toggle-topic(int); callback save-topics; callback react(int);
    background: Ink.paper;
    HorizontalLayout {
        alignment: center;
        VerticalLayout {
            width: min(640px, root.width - 80px); padding-top: 60px; padding-bottom: 40px; spacing: 18px;
            HorizontalLayout { spacing: 4px; for i in [0, 1, 2, 3, 4, 5]: Rectangle { height: 3px; border-radius: 2px; background: i <= root.step ? Ink.clay : Ink.line; animate background { duration: 350ms; } } }
            Rectangle { height: 24px; }
            if root.step == 0: Appear { rise: 18px; VerticalLayout {
                spacing: 16px;
                Wordmark { size: 52px; }
                Appear { delay: 150ms; Para { text: "Your mail, news and day, sorted quietly on this computer."; glyph: 0.47; font-family: Ink.serif; font-size: 30px; color: Ink.text; } }
                Appear { delay: 300ms; Para { text: "Each morning you get a few sentences on what needs you. Everything else waits."; color: Ink.text2; font-size: 16px; } }
            } }
            if root.step == 1: Appear { VerticalLayout { spacing: 14px; Text { text: "What should we call you?"; font-family: Ink.serif; font-size: 30px; color: Ink.text; } Field { placeholder: "First name"; text <=> root.name; accepted => { if root.name != "" { root.save-name(); root.step = 2; } } } } }
            if root.step == 2: Appear { VerticalLayout {
                spacing: 14px;
                Text { text: "What are you into?"; font-family: Ink.serif; font-size: 30px; color: Ink.text; }
                Para { text: "Pick a few. You'll fine-tune it next by swiping stories, and you can change it any time in Settings."; color: Ink.text2; font-size: 15px; }
                TopicPicker { topics: root.topics; toggle(i) => { root.toggle-topic(i); } }
            } }
            if root.step == 3: Appear { VerticalLayout {
                spacing: 10px; vertical-stretch: 1;
                Text { text: "Teach it your taste"; font-family: Ink.serif; font-size: 30px; color: Ink.text; }
                Para { text: "A few real stories from today. Tell it which you'd read."; color: Ink.text2; font-size: 15px; }
                Deck { deck: root.deck; done-text: "That's enough to start. It keeps learning as you read."; react(r) => { root.react(r); } }
            } }
            if root.step == 4: Appear { VerticalLayout { spacing: 14px; Text { text: "Connect your mail"; font-family: Ink.serif; font-size: 30px; color: Ink.text; } MailSetup { provider <=> root.provider; email <=> root.mail-email; password <=> root.mail-password; busy: root.busy; error: root.error; connect => { root.connect(); } } } }
            if root.step == 5: Appear { VerticalLayout {
                spacing: 14px;
                Text { text: "Add an AI key"; font-family: Ink.serif; font-size: 30px; color: Ink.text; }
                Field { label: "Gemini API key"; placeholder: "AIza…"; secret: true; text <=> root.key-input; accepted => { root.save-key(); } }
                Para { text: root.key-note != "" ? root.key-note : "Free from aistudio.google.com. Kept in Windows Credential Manager."; color: Ink.text2; font-size: 13.5px; }
                HorizontalLayout { alignment: start; Button { text: "Save key"; primary: true; enabled: root.key-input != ""; clicked => { root.save-key(); } } }
            } }
            Rectangle { vertical-stretch: 1; }
            HorizontalLayout {
                alignment: start; spacing: 10px;
                if root.step > 0: Button { text: "Back"; clicked => { root.step -= 1; } }
                if root.step == 0: Button { text: "Get started"; primary: true; clicked => { root.step = 1; } }
                if root.step == 1: Button { text: "Continue"; primary: true; enabled: root.name != ""; clicked => { root.save-name(); root.step = 2; } }
                if root.step == 2: Button { text: "Continue"; primary: true; clicked => { root.save-topics(); root.step = 3; } }
                if root.step == 3: Button { text: root.deck.length == 0 ? "Continue" : "Skip"; primary: root.deck.length == 0; clicked => { root.step = 4; } }
                if root.step == 4: Button { text: "Skip for now"; clicked => { root.step = 5; } }
                if root.step == 5: Button { text: "Skip for now"; clicked => { root.finish(); } }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "everyday.";
    icon: @image-url("../../app/icons/icon.png");
    preferred-width: 1240px; preferred-height: 820px;
    min-width: 940px; min-height: 620px;
    background: Ink.paper;
    default-font-size: 14px;

    in-out property <int> page;
    in property <bool> ready;
    in-out property <bool> onboarded;
    in-out property <int> step;
    in property <string> toast;
    in property <bool> syncing;

    // Today
    in property <string> greeting; in property <string> date-text; in property <[Section]> briefing; in property <bool> has-key; in property <bool> writing; in property <bool> speaking;
    in property <[ReplyChip]> replies; in property <[EventRow]> events;
    // Mail
    in property <[MailRow]> needs; in property <[MailRow]> rest; in property <string> email; in property <string> selected;
    in property <string> subject; in property <string> summary; in property <bool> security; in property <[Msg]> messages; in property <int> countdown;
    in-out property <string> draft;
    // News, tasks, ask
    in property <[Story]> stories; in property <[Story]> deck; in-out property <int> news-mode;
    in property <[TaskItem]> tasks; in-out property <string> task-input;
    in property <[Turn]> turns; in property <bool> thinking; in-out property <string> ask-input;
    // Settings
    in-out property <string> name; in-out property <string> key-input; in property <string> key-note; in-out property <string> ics; in-out property <bool> morning; in-out property <int> hour: 7;
    in-out property <int> provider; in-out property <string> mail-email; in-out property <string> mail-password; in property <bool> busy; in property <string> error;
    in property <[TopicRow]> topics; in property <string> top-interests; in-out property <string> instructions; in-out property <int> settings-tab;
    in-out property <bool> collapsed;

    in property <bool> sync-paired; in property <int> sync-nearby; in property <[SyncDevice]> sync-devices;
    in property <string> sync-error; in property <bool> sync-busy; in property <string> sync-code; in property <image> sync-qr;
    in-out property <bool> sync-include-setup: true; in-out property <string> sync-entered;
    callback sync-show-code; callback sync-hide-code; callback sync-join; callback sync-now; callback sync-leave;
    callback toggle-topic(int); callback save-topics; callback train; callback reset-interests; callback save-instructions;
    callback refresh; callback write-briefing; callback listen; callback reply(int);
    callback open-thread(string); callback archive; callback trash; callback snooze(int); callback handled; callback send; callback undo;
    callback open-url(string); callback react(int);
    callback add-task; callback toggle-task(string); callback delete-task(string);
    callback ask(string);
    callback save-name; callback save-ics; callback save-morning; callback connect; callback disconnect; callback save-key; callback finish;

    forward-focus: keys;
    keys := FocusScope {
        key-pressed(e) => {
            if e.modifiers.control && e.text == "b" { root.collapsed = !root.collapsed; return accept; }
            if e.modifiers.control && e.text >= "1" && e.text <= "6" { root.page = e.text.to-float() - 1; return accept; }
            if root.page == 2 && root.news-mode == 1 {
                if e.text == Key.LeftArrow { root.react(-1); return accept; }
                if e.text == Key.RightArrow { root.react(1); return accept; }
                if e.text == Key.UpArrow { root.react(2); return accept; }
            }
            reject
        }
    }

    if !root.ready: Rectangle { Wordmark { size: 40px; x: (parent.width - self.preferred-width) / 2; y: (parent.height - self.preferred-height) / 2; } }

    if root.ready && !root.onboarded: Onboarding {
        step <=> root.step; name <=> root.name; provider <=> root.provider; mail-email <=> root.mail-email; mail-password <=> root.mail-password; busy: root.busy; error: root.error;
        key-input <=> root.key-input; key-note: root.key-note; topics: root.topics; deck: root.deck;
        connect => { root.connect(); } save-key => { root.save-key(); } finish => { root.finish(); } save-name => { root.save-name(); }
        toggle-topic(i) => { root.toggle-topic(i); } save-topics => { root.save-topics(); } react(r) => { root.react(r); }
    }

    if root.ready && root.onboarded: HorizontalLayout {
        // The sidebar folds down to icons (Ctrl+B or the button at the top).
        Rectangle {
            width: root.collapsed ? 64px : 216px; background: Ink.sidebar; clip: true;
            animate width { duration: 240ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
            if root.page < 5: Rectangle {
                x: 14px; width: 3px; height: 16px; border-radius: 2px; background: Ink.clay; z: 2;
                y: 74px + root.page * 40px;
                animate y { duration: 260ms; easing: cubic-bezier(0.2, 0.9, 0.25, 1.15); }
            }
            VerticalLayout {
                padding: 10px; padding-top: 18px; spacing: 2px;
                HorizontalLayout {
                    height: 44px; padding-left: root.collapsed ? 10px : 14px; padding-bottom: 8px;
                    if !root.collapsed: Wordmark { size: 23px; horizontal-stretch: 1; }
                    Rectangle {
                        width: 28px; height: 28px; border-radius: 6px; background: tg.has-hover ? Ink.paper : transparent;
                        Image { source: @image-url("icons/sidebar.svg"); width: 18px; height: 18px; colorize: Ink.text3; }
                        tg := TouchArea { mouse-cursor: pointer; clicked => { root.collapsed = !root.collapsed; } }
                    }
                }
                for item[i] in [
                    { name: "Today", icon: @image-url("icons/today.svg") }, { name: "Inbox", icon: @image-url("icons/inbox.svg") },
                    { name: "News", icon: @image-url("icons/news.svg") }, { name: "Tasks", icon: @image-url("icons/tasks.svg") }, { name: "Ask", icon: @image-url("icons/ask.svg") }
                ]: NavItem { text: item.name; icon: item.icon; collapsed: root.collapsed; on: root.page == i; badge: i == 1 ? root.needs.length : 0; clicked => { root.page = i; } }
                Rectangle { vertical-stretch: 1; }
                if root.syncing && !root.collapsed: Text { text: "Checking for new mail…"; color: Ink.text3; font-size: 12px; x: 12px; }
                NavItem { text: "Settings"; icon: @image-url("icons/settings.svg"); collapsed: root.collapsed; on: root.page == 5; clicked => { root.page = 5; } }
            }
        }
        Rectangle { width: 1px; background: Ink.line; }
        Rectangle {
            horizontal-stretch: 1;
            if root.page == 0: PageIn { TodayPage {
                greeting: root.greeting; date-text: root.date-text; briefing: root.briefing; has-key: root.has-key; writing: root.writing; speaking: root.speaking;
                replies: root.replies; needs: root.needs; events: root.events; tasks: root.tasks; stories: root.stories;
                write-briefing => { root.write-briefing(); } listen => { root.listen(); } reply(i) => { root.reply(i); }
                open-thread(t) => { root.page = 1; root.open-thread(t); } toggle-task(t) => { root.toggle-task(t); } open-url(u) => { root.open-url(u); } settings => { root.page = 5; }
            } }
            if root.page == 1: PageIn { InboxPage {
                needs: root.needs; rest: root.rest; connected: root.email != ""; syncing: root.syncing; selected: root.selected;
                subject: root.subject; summary: root.summary; security: root.security; messages: root.messages; countdown: root.countdown; draft <=> root.draft;
                open-thread(t) => { root.open-thread(t); } refresh => { root.refresh(); } archive => { root.archive(); } trash => { root.trash(); } snooze(h) => { root.snooze(h); }
                handled => { root.handled(); } send => { root.send(); } undo => { root.undo(); }
            } }
            if root.page == 2: PageIn { NewsPage { stories: root.stories; deck: root.deck; mode <=> root.news-mode; open-url(u) => { root.open-url(u); } react(r) => { root.react(r); } refresh => { root.refresh(); } } }
            if root.page == 3: PageIn { TasksPage { tasks: root.tasks; input <=> root.task-input; add => { root.add-task(); } toggle(t) => { root.toggle-task(t); } delete(t) => { root.delete-task(t); } } }
            if root.page == 4: PageIn { AskPage { turns: root.turns; thinking: root.thinking; has-key: root.has-key; input <=> root.ask-input; ask(q) => { root.ask(q); } } }
            if root.page == 5: PageIn { SettingsPage {
                sync-paired: root.sync-paired; sync-nearby: root.sync-nearby; sync-devices: root.sync-devices; sync-error: root.sync-error; sync-busy: root.sync-busy;
                sync-code: root.sync-code; sync-qr: root.sync-qr; sync-include-setup <=> root.sync-include-setup; sync-entered <=> root.sync-entered;
                sync-show-code => { root.sync-show-code(); } sync-hide-code => { root.sync-hide-code(); } sync-join => { root.sync-join(); } sync-now => { root.sync-now(); } sync-leave => { root.sync-leave(); }
                tab <=> root.settings-tab; name <=> root.name; email: root.email; has-key: root.has-key; key-input <=> root.key-input; ics <=> root.ics; morning <=> root.morning; hour <=> root.hour;
                instructions <=> root.instructions; topics: root.topics; top-interests: root.top-interests;
                provider <=> root.provider; mail-email <=> root.mail-email; mail-password <=> root.mail-password; busy: root.busy; error: root.error; key-note: root.key-note;
                save-name => { root.save-name(); } save-ics => { root.save-ics(); } save-morning => { root.save-morning(); } connect => { root.connect(); } disconnect => { root.disconnect(); } save-key => { root.save-key(); }
                save-instructions => { root.save-instructions(); } toggle-topic(i) => { root.toggle-topic(i); } train => { root.train(); } reset-interests => { root.reset-interests(); }
            } }
        }
    }

    // A short message slides up from the bottom and fades after a few seconds.
    if root.toast != "": Appear {
        rise: 24px;
        x: (parent.width - self.width) / 2; y: parent.height - self.height - 24px;
        width: tt.preferred-width + 36px; height: 42px;
        Rectangle {
        border-radius: 12px; background: Ink.text;
        tt := Text { text: root.toast; color: Ink.paper; font-size: 14px; }
    } }
}
