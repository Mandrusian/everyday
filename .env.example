# Copy to .env (git ignores it) and fill in what you need. Never commit real values.

# Cloudflare API token for Scripts/cloudflare-dns.sh.
# Create at dash.cloudflare.com → My Profile → API Tokens → Create Token → "Edit zone DNS", limited to your zone.
CF_API_TOKEN=
CF_ZONE=mandrusia.tech
# Space-separated hostnames (without the zone) to delete, e.g. "old1 old2". Leave empty to delete nothing.
CF_DELETE_RECORDS=

# Optional live checks: swift run EverydayChecks
GEMINI_API_KEY=
IMAP_EMAIL=
IMAP_PASSWORD=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
